# ── ElevenLabs ────────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_MODEL_ID=scribe_v2_realtime

# ── Five9 VoiceStream ─────────────────────────────────────────────────────────
# Trust Token — the secret string you enter in the Five9 subscription form.
# Five9 echoes it in gRPC metadata header x-five9-trust-token.
# Also used to generate the SHA-256 challenge response for CTI URL validation.
FIVE9_TRUST_TOKEN=your_generated_secret_token_here

# API Key — generated by Five9 after subscription creation (shown ONCE, copy it!).
# Five9 sends this in the X-F9-APIKEY header on every CTI Call Event webhook POST.
# Leave blank to skip validation (useful during initial testing).
FIVE9_API_KEY=

# ── Server ────────────────────────────────────────────────────────────────────
# gRPC port — Five9 connects here; requires TLS in production (use a reverse proxy)
GRPC_PORT=50051

# HTTP port — for subscription validation GET and webhook callback POSTs
HTTP_PORT=3000

# Set to "true" when the gRPC port is exposed directly with TLS
# Set to "false" when running behind a TLS-terminating reverse proxy (nginx / Cloud Run)
GRPC_TLS=false

# TLS cert/key paths (only needed when GRPC_TLS=true and you handle TLS yourself)
# TLS_CERT_PATH=/etc/certs/server.crt
# TLS_KEY_PATH=/etc/certs/server.key

# ── Debugging ─────────────────────────────────────────────────────────────────
# Set to "true" to log every raw gRPC message without forwarding audio to ElevenLabs.
# Use this to discover the exact field names Five9 sends if the proto doesn't match.
PROTO_DISCOVERY=false
